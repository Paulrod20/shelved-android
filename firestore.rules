rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function owns(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Account libraries are private by default. Public social data will live in
    // a separate collection with an intentionally narrower public schema.
    match /users/{userId} {
      allow read, create, update, delete: if owns(userId);

      match /{document=**} {
        allow read, create, update, delete: if owns(userId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
